generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Roles {
  OWNER
  MANAGER
  EMPLOYEE
  CLIENT
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String   @unique

  company_name  String
  company_id    Int
  company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  hash_password String
  role          Roles
  key           String   @unique

  team_id       Int?
  team          Team?    @relation(fields: [team_id], references: [id], onDelete: SetNull)

  client_info   ClientInfo?

  updatedAt     DateTime @updatedAt

  equipamentos Equipamento[]
}

model ClientInfo {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  nome       String
  documento  String?  // CPF / CNPJ
  email      String?
  telefone   String?
  endereco   String?
  avatar_url String?

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("client_info")
}

enum KeyStatus {
  USED
  AVAILABLE
}

model Key {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  company_id Int
  status     KeyStatus
  role       String
  bound_user String
}

enum AtividadeStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

model Company {
  id    Int     @id @default(autoincrement())
  name  String
  owner String?

  primary_color   String? @default("#1e293b")
  secondary_color String? @default("#334155")
  button_color    String? @default("#2563eb")
  logo_url        String? @db.Text 

  users        User[]
  teams        Team[]
  forms        Form[]
  atividades   Atividade[]
  equipamentos Equipamento[]
}

model Team {
  id   Int    @id @default(autoincrement())
  name String

  company_id Int
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  members    User[]
  atividades Atividade[]
}

model Form {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  duration    Int      @default(0)
  linkedTo    String?  @map("linked_to")
  questions   Json
  company_id  Int     
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  atividades Atividade[]

  @@map("forms")
}

model Atividade {
  id            Int             @id @default(autoincrement())
  titulo        String
  descricao     String?
  horario       String
  data          DateTime        @db.Date
  status        AtividadeStatus @default(PENDENTE)
  cor           String?         @default("bg-blue-500")
  form_resposta Json?           @map("form_resposta")

  company_id Int
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  team_id Int?
  team    Team? @relation(fields: [team_id], references: [id], onDelete: SetNull)

  form_id Int?
  form    Form? @relation(fields: [form_id], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("atividades")
}

model Equipamento {
  id         Int      @id @default(autoincrement())
  nome       String
  atributos  Json

  company_id Int
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  client_id  Int
  client     User     @relation(fields: [client_id], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("equipamentos")
}

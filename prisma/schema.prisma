generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

enum Roles {
    OWNER
    MANAGER
    EMPLOYEE
    CLIENT
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String   @unique
  company_name  String
  company_id    Int      @unique
  hash_password String   @unique
  role          Roles
  key           String   @unique
  updatedAt     DateTime @updatedAt
}

enum KeyStatus{
    USED
    AVAILABLE
}

model Key {
    id         Int       @id @default(autoincrement())
    code       String    @unique
    company_id Int
    status     KeyStatus
}

model Company {
    id    Int    @id @default(autoincrement())
    owner String
}

